use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests
	- examples

excludePaths:
	- tests/**/expected

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
	- # the deprecated getHttpData() keeps working through the deprecated extractHttpData()
		paths: [src/Forms/Form.php]
		upgrading: {declarations: {deprecatedMember: keep}}
	- # Form::URL is established public API
		paths: [src/Forms/Form.php]
		naming: {constant: keep}
	- # setValue($values) keeps its name, renaming it breaks named arguments
		paths: [src/Forms/Controls/MultiChoiceControl.php]
		classes: {overridingMethod: {parameterName: keep}}
	- # the parameter names come from the trait of nette/component-model
		paths: [src/Forms/Container.php]
		classes: {overridingMethod: {parameterName: keep}}
	- # the alternative syntax suits PHP inside HTML
		paths: [examples/manual-rendering.php]
		braces: {alternativeSyntax: keep}
