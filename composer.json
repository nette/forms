{
	"name": "nette/forms",
	"description": "📝 Nette Forms: secure forms with one set of validation rules for server and browser, CSRF protection, and rendering done automatically or by hand in Latte.",
	"keywords": ["nette", "forms", "form validation", "form builder", "client-side validation", "csrf"],
	"homepage": "https://doc.nette.org/forms",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.1 - 8.5",
		"nette/component-model": "^3.1",
		"nette/http": "^3.3",
		"nette/utils": "^4.0.4"
	},
	"require-dev": {
		"nette/application": "^3.0",
		"nette/di": "^3.0",
		"nette/tester": "^2.6",
		"latte/latte": "^2.10.2 || ^3.0.12",
		"tracy/tracy": "^2.9",
		"phpstan/phpstan": "^2.1@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"conflict": {
		"latte/latte": ">=3.0.0 <3.0.12 || >=3.2"
	},
	"suggest": {
		"ext-intl": "to use date/time controls"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Nette\\": "src"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.2-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
